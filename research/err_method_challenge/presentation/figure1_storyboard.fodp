<?xml version="1.0" encoding="UTF-8"?><office:document
      xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
      xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0"
      xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0"
      xmlns:draw="urn:oasis:names:tc:opendocument:xmlns:drawing:1.0"
      xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0"
      xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0"
      office:version="1.2" office:mimetype="application/vnd.oasis.opendocument.presentation">
      <office:styles/><office:automatic-styles>
      <style:page-layout style:name="wide"><style:page-layout-properties fo:page-width="33.867cm" fo:page-height="19.05cm" style:print-orientation="landscape"/></style:page-layout>
    <style:style style:name="plain" style:family="graphic"><style:graphic-properties draw:fill="solid" draw:fill-color="#FFFFFF" draw:stroke="solid" svg:stroke-color="#B2BAC5" fo:padding="0.25cm" draw:textarea-vertical-align="top"/></style:style><style:style style:name="blue" style:family="graphic"><style:graphic-properties draw:fill="solid" draw:fill-color="#EAF1FA" draw:stroke="solid" svg:stroke-color="#B2BAC5" fo:padding="0.25cm" draw:textarea-vertical-align="top"/></style:style><style:style style:name="amber" style:family="graphic"><style:graphic-properties draw:fill="solid" draw:fill-color="#FFF1D8" draw:stroke="solid" svg:stroke-color="#B2BAC5" fo:padding="0.25cm" draw:textarea-vertical-align="top"/></style:style><style:style style:name="green" style:family="graphic"><style:graphic-properties draw:fill="solid" draw:fill-color="#E6F3E9" draw:stroke="solid" svg:stroke-color="#B2BAC5" fo:padding="0.25cm" draw:textarea-vertical-align="top"/></style:style><style:style style:name="grey" style:family="graphic"><style:graphic-properties draw:fill="solid" draw:fill-color="#EFF1F4" draw:stroke="solid" svg:stroke-color="#B2BAC5" fo:padding="0.25cm" draw:textarea-vertical-align="top"/></style:style><style:style style:name="body" style:family="paragraph"><style:paragraph-properties fo:margin-bottom="0.15cm"/><style:text-properties fo:font-family="Liberation Sans" fo:font-size="14pt" fo:font-weight="normal" fo:color="#172A41"/></style:style><style:style style:name="small" style:family="paragraph"><style:paragraph-properties fo:margin-bottom="0.15cm"/><style:text-properties fo:font-family="Liberation Sans" fo:font-size="12pt" fo:font-weight="normal" fo:color="#172A41"/></style:style><style:style style:name="title" style:family="paragraph"><style:paragraph-properties fo:margin-bottom="0.15cm"/><style:text-properties fo:font-family="Liberation Sans" fo:font-size="25pt" fo:font-weight="bold" fo:color="#172A41"/></style:style></office:automatic-styles><office:master-styles><style:master-page style:name="Default" style:page-layout-name="wide"/></office:master-styles><office:body><office:presentation><draw:page draw:name="Figure_1_storyboard" draw:master-page-name="Default"><draw:frame draw:name="title" draw:style-name="plain" svg:x="0.7cm" svg:y="0.4cm" svg:width="32cm" svg:height="1.3cm"><draw:text-box><text:p text:style-name="title">What evidence would settle this recovery claim?</text:p></draw:text-box></draw:frame><draw:frame draw:name="subtitle" draw:style-name="plain" svg:x="0.7cm" svg:y="1.8cm" svg:width="32cm" svg:height="0.9cm"><draw:text-box><text:p text:style-name="small">EDITABLE STORYBOARD • implemented finite-model prototype • empirical value remains a Stage 2 hypothesis</text:p></draw:text-box></draw:frame><draw:frame draw:name="inputs" draw:style-name="blue" svg:x="0.7cm" svg:y="3cm" svg:width="9.8cm" svg:height="10.8cm"><draw:text-box><text:p text:style-name="body">A  FACTS + SOURCE + OBLIGATION</text:p><text:p text:style-name="body"></text:p><text:p text:style-name="body">Recorded predecision facts</text:p><text:p text:style-name="body">Pick goal distance: 3.85 vs 2.21 cm</text:p><text:p text:style-name="body">Same five other recorded facts</text:p><text:p text:style-name="body"></text:p><text:p text:style-name="body">Fixed continue / recover macros</text:p><text:p text:style-name="body">Declared checkpoint and horizon</text:p><text:p text:style-name="body"></text:p><text:p text:style-name="body">Useful recovery: harm ≤ 0.10</text:p><text:p text:style-name="body">and expected gain ≥ 0.05</text:p><text:p text:style-name="body"></text:p><text:p text:style-name="body">Original whole-leaf calibration</text:p><text:p text:style-name="body">and source assumptions stay fixed</text:p></draw:text-box></draw:frame><draw:frame draw:name="models" draw:style-name="amber" svg:x="11.1cm" svg:y="3cm" svg:width="10cm" svg:height="10.8cm"><draw:text-box><text:p text:style-name="body">B  COMPATIBLE OUTCOME LAWS</text:p><text:p text:style-name="body"></text:p><text:p text:style-name="body">ANALYTICAL WORLDS — NOT EPISODES</text:p><text:p text:style-name="body"></text:p><text:p text:style-name="body">Qlow  = (.4, .2, 0, .4)</text:p><text:p text:style-name="body">Qhigh = (0, .6, .4, 0)</text:p><text:p text:style-name="body">Order: (00, 01, 10, 11)</text:p><text:p text:style-name="body"></text:p><text:p text:style-name="body">Same p0 = .4 and p1 = .6</text:p><text:p text:style-name="body">Different harm: 0 versus .4</text:p><text:p text:style-name="body"></text:p><text:p text:style-name="body">One-arm laws cannot separate them.</text:p><text:p text:style-name="body">A qualified paired law can differ.</text:p><text:p text:style-name="body">Different laws ≠ finite-sample certainty.</text:p></draw:text-box></draw:frame><draw:frame draw:name="certified" draw:style-name="green" svg:x="21.7cm" svg:y="3cm" svg:width="11.4cm" svg:height="3.3cm"><draw:text-box><text:p text:style-name="body">C  CERTIFIED RECOVER</text:p><text:p text:style-name="body">Original minimum facts + whole scope</text:p><text:p text:style-name="body">One selected fixed action online</text:p></draw:text-box></draw:frame><draw:frame draw:name="unresolved" draw:style-name="amber" svg:x="21.7cm" svg:y="6.7cm" svg:width="11.4cm" svg:height="3.3cm"><draw:text-box><text:p text:style-name="body">UNRESOLVED</text:p><text:p text:style-name="body">Minimum identifying experiment-TYPE plan</text:p><text:p text:style-name="body">Offline data may also REFUTE recovery</text:p></draw:text-box></draw:frame><draw:frame draw:name="impossible" draw:style-name="grey" svg:x="21.7cm" svg:y="10.4cm" svg:width="11.4cm" svg:height="3.4cm"><draw:text-box><text:p text:style-name="body">NOT RESOLVABLE WITH THIS MENU</text:p><text:p text:style-name="body">Opposite verdicts; identical available laws</text:p><text:p text:style-name="body">Return the explicit countermodel pair</text:p></draw:text-box></draw:frame><draw:frame draw:name="offline" draw:style-name="grey" svg:x="0.7cm" svg:y="14.3cm" svg:width="32.4cm" svg:height="1.1cm"><draw:text-box><text:p text:style-name="small">OFFLINE: evidence collection and paired evaluation     · · ·     ONLINE: one fixed action only</text:p></draw:text-box></draw:frame><draw:frame draw:name="old_physics" draw:style-name="plain" svg:x="0.7cm" svg:y="15.8cm" svg:width="32.4cm" svg:height="1.4cm"><draw:text-box><text:p text:style-name="small">Existing DSRE preliminaries, unchanged: Pick 84 rescues / 111 recoveries; Push 126 / 128.</text:p><text:p text:style-name="small">Instrumented B7 + identical planner is equivalent. No new physical paired-only case or acquisition gain.</text:p></draw:text-box></draw:frame><draw:frame draw:name="scope" draw:style-name="plain" svg:x="0.7cm" svg:y="17.6cm" svg:width="32.4cm" svg:height="0.8cm"><draw:text-box><text:p text:style-name="small">Story illustration only. No new manuscript figure, rollout, sensor-cost measurement or acceptance claim.</text:p></draw:text-box></draw:frame></draw:page><draw:page draw:name="Page_budget" draw:master-page-name="Default"><draw:frame draw:name="page_title" draw:style-name="plain" svg:x="0.7cm" svg:y="0.5cm" svg:width="32cm" svg:height="1.5cm"><draw:text-box><text:p text:style-name="title">Five content pages + one references page</text:p></draw:text-box></draw:frame><draw:frame draw:name="page_budget" draw:style-name="blue" svg:x="0.9cm" svg:y="3cm" svg:width="31.8cm" svg:height="11.3cm"><draw:text-box><text:p text:style-name="body">1  Problem, testable hypothesis and Figure 1: why the evidence source matters.</text:p><text:p text:style-name="body"></text:p><text:p text:style-name="body">2  Fixed actions, q/h/g, source assumptions and conditional statistical scope.</text:p><text:p text:style-name="body"></text:p><text:p text:style-name="body">3  Finite-world resolving-menu objective, standard cover proof and exact algorithm.</text:p><text:p text:style-name="body"></text:p><text:p text:style-name="body">4  Unchanged Pick/Push preliminaries, recorded-fact witness, analytical source contrast; B7 equality.</text:p><text:p text:style-name="body"></text:p><text:p text:style-name="body">5  Novelty limits, falsifiable Stage 2 protocol, independent calibration and null outcomes.</text:p><text:p text:style-name="body"></text:p><text:p text:style-name="body">6  References only: include harm bounds, UPS/targeted queries, DRD/ECD, test-cover and RESCUE.</text:p></draw:text-box></draw:frame><draw:frame draw:name="do_not_claim" draw:style-name="amber" svg:x="0.9cm" svg:y="15.2cm" svg:width="31.8cm" svg:height="2.4cm"><draw:text-box><text:p text:style-name="small">Do not claim: new generic experiment-selection theory; unique B7 solver; a finite-sample guarantee from signatures;</text:p><text:p text:style-name="small">actual paired-only robot evidence; new physical efficiency; or a repaired recovery skill.</text:p></draw:text-box></draw:frame></draw:page></office:presentation></office:body></office:document>